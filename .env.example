# Bi-Etkinlik backend ortam değişkenleri — örnek dosya
# Kopyala: cp .env.example .env  ve değerleri doldur. .env asla commit edilmez.

# PostgreSQL bağlantısı (.NET, appsettings'teki ConnectionStrings:Default'u ezer)
ConnectionStrings__Default=Host=postgres;Port=5432;Database=SEP_Db;Username=postgres;Password=CHANGE_ME_STRONG_PASSWORD

# docker-compose postgres servisi için aynı parola
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT imzalama anahtarı (en az 64 karakter, rastgele üretin: openssl rand -base64 64)
TokenOptions__Key=CHANGE_ME_RANDOM_64+_CHAR_SECRET

# İsteğe bağlı: JWT Issuer/Audience (varsayılanlar appsettings.json'da; üretim ve
# doğrulama aynı config'i okuduğu için tutarlılık otomatiktir)
# TokenOptions__Issuer=api.ornek-domain.com
# TokenOptions__Audience=www.ornek-domain.com

# SMTP (Gmail uygulama şifresi)
EmailSettings__SmtpUser=ornek@gmail.com
EmailSettings__SmtpPass=

# CORS - izinli frontend origin'leri (dizi: __0, __1, ... ile devam eder)
Cors__AllowedOrigins__0=https://www.ornek-domain.com

# Host header kontrolü — prod'da gerçek domain'inizle sınırlayın ("*" = hepsi)
AllowedHosts=*

# Başlangıç admin kullanıcısı (idempotent seed). İKİSİ DE doluysa oluşturulur;
# boşsa admin oluşturma sessizce atlanır. Parola politikası: en az 8 karakter,
# büyük/küçük harf, rakam ve özel karakter zorunlu.
Seed__AdminEmail=admin@ornek-domain.com
Seed__AdminPassword=CHANGE_ME_Aa1!strong

# Frontend build: API taban adresi (build arg olarak geçilir).
# Boş = aynı origin (nginx proxy üzerinden, önerilen). Ayrı API domain'i varsa doldurun.
VITE_API_BASE=
